{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Main window: core commands, file dialog, drag-drop, opener for the data folder.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "dialog:default",
    "dialog:allow-open",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "core:tray:default",
    "core:menu:default",
    "dialog:allow-save"
  ]
}